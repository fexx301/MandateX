# Single-host deployment environment. Copy to deploy/.env and fill in.
#
#   cp deploy/compose.env.example deploy/.env
#
# deploy/.env is gitignored. It holds the signing key, which is the most
# sensitive value in the system, so it must never be committed and never pasted
# into a shell that records history.

# ── The verifier's signing authority (verifier service only) ─────────────────

# Names the key in every attestation issued. Must NOT contain "fixture",
# "insecure", "do-not-deploy", "test" or "dev-": the verifier refuses to boot
# under NODE_ENV=production with a development key id, because such an id tells
# every consumer not to trust what it signs.
MANDATEX_SIGNING_KEY_ID=mandatex-verifier-1

# Ed25519 private key: 32-byte seed hex (64 chars) or PKCS#8 DER hex (96 chars).
#
# Generate one without writing it to disk or shell history. Note the LEADING
# SPACE, which keeps the line out of history under zsh HIST_IGNORE_SPACE or bash
# HISTCONTROL=ignorespace:
#
#     node -e 'const{generateKeyPairSync}=require("node:crypto");console.log(generateKeyPairSync("ed25519").privateKey.export({type:"pkcs8",format:"der"}).toString("hex"))'
#
# The committed fixture key is refused in production. It is forgeable by anyone
# who can read this repository.
MANDATEX_SIGNING_KEY=

# ── The app's pins (app service only) ───────────────────────────────────────
#
# FILL THESE FROM THE RUNNING VERIFIER, NOT FROM WHAT YOU THINK YOU CONFIGURED.
# Deriving the pin from the deployed verifier is the whole point: it is what makes
# the two services provably the same generation. After the verifier is up:
#
#     docker compose -f deploy/compose.yaml exec verifier \
#       node -e "fetch('http://127.0.0.1:8080/v1/trust').then(r=>r.json()).then(t=>console.log(JSON.stringify(t,null,2)))"
#
# Copy keyId -> MANDATEX_TRUST_KEY_ID, publicKeySpkiDerHex -> SPKI_DER_HEX,
# publicKeyFingerprintSha256 -> KEY_FINGERPRINT_SHA256, verifierPolicySha256 ->
# POLICY_SHA256. Then `docker compose up -d app` and check the app's /readyz:
# 200 with verifier "ok" means the pair agrees, 503 "key_mismatch" means it does
# not and names both fingerprints.
MANDATEX_TRUST_KEY_ID=mandatex-verifier-1
MANDATEX_TRUST_SPKI_DER_HEX=
MANDATEX_TRUST_KEY_FINGERPRINT_SHA256=
MANDATEX_TRUST_POLICY_SHA256=

# ── Not variables of this deployment ────────────────────────────────────────
#
# There is no TLS or hostname setting here. This stack ships no web server: the UI
# binds 127.0.0.1:8090 and the proxy you already run terminates TLS and owns the
# hostname. Nothing here needs to know the public name.
#
# There is also no MANDATEX_TRUST_* on the verifier and no MANDATEX_SIGNING_* on
# the app. Compose passes each service only its own half, and both refuse to boot
# in the other's posture. A process that both signs and verifies proves nothing,
# because every signature it checks is one it could have produced.
