# Verifier service environment — the SIGNING side.
#
# Mirror image of deploy/app.env.example. That file has deliberately no variable
# for a private key; this one has exactly one, and it is the most sensitive value
# in the system. Set it as a platform secret. Never commit it, never paste it into
# a shell that records history, never put it in a Railway *shared* variable where
# every service in the project can read it.
#
# The process exits 78 at boot if this key is absent, malformed, or is the
# publicly-committed fixture key while NODE_ENV=production.

# ── Required ─────────────────────────────────────────────────────────────────

# Names the key in every attestation issued. The marketplace app pins the same id.
# Must not contain "fixture", "insecure", "do-not-deploy", "test" or "dev-" under
# production: a development key id tells every consumer not to trust what it signs.
MANDATEX_SIGNING_KEY_ID=mandatex-verifier-1

# Ed25519 private key. Accepted as either a bare 32-byte seed in hex (64 chars) or
# full PKCS#8 DER in hex beginning 302e020100300506032b6570.
#
# Generate one WITHOUT writing it to disk or to shell history — note the leading
# space, which keeps it out of history in bash/zsh with HISTCONTROL/HIST_IGNORE_SPACE:
#
#    node -e 'const{generateKeyPairSync}=require("node:crypto");console.log(generateKeyPairSync("ed25519").privateKey.export({type:"pkcs8",format:"der"}).toString("hex"))'
#
# Paste the output straight into the platform's secret field and close the terminal.
# Then read the public half back from the running service's GET /v1/trust and pin
# those values in the marketplace app — that is what makes the pair lockstep.
MANDATEX_SIGNING_KEY=<64-char seed hex, or 96-char PKCS#8 DER hex>

# ── Optional ─────────────────────────────────────────────────────────────────

# Directory holding the three artifacts of an agent-supply-verifier passive run:
#   manifest.json, passive-report.json, quote-trust.json
#
# Absent is a supported state, not a broken one. Without it the service still
# serves GET /v1/trust and GET /healthz — which is all the marketplace app needs
# to prove key agreement — and POST /v1/evaluate returns 503 with an explanation.
# That is deliberate: requiring a live agent's artifacts in order to boot would
# block standing up the trust boundary until the whole supply pipeline is finished,
# which is backwards, since the boundary is what everything else is verified against.
# MANDATEX_VERIFIER_CONFIG_DIR=/srv/verifier-config

# Pins the verifier's policy identity. Leave unset on a fresh deploy: when the
# artifacts are present the service derives this value from them and reports it on
# GET /v1/trust. Once derived, pin it here for production — after that a silent
# artifact swap makes the service refuse to boot instead of quietly signing under a
# policy identity that no longer describes its configuration.
# MANDATEX_VERIFIER_POLICY_SHA256=<64 lowercase hex>

# Request body cap in bytes. Default 1048576.
# MANDATEX_MAX_REQUEST_BYTES=1048576

# ── Set by the platform ──────────────────────────────────────────────────────
# PORT      — Railway injects this; the service binds it.
# HOST      — defaults to 0.0.0.0, already set in the image.
# NODE_ENV  — set to production in the image, which is what arms the key guards.

# ── Not variables of this service ────────────────────────────────────────────
# There is no MANDATEX_TRUST_* here. Those belong to the marketplace app, which
# pins the PUBLIC half of this key. If you find yourself setting both families on
# one service, the trust boundary has collapsed and neither service's guarantees
# hold: a process that both signs and verifies proves nothing, because every
# signature it checks is one it could have produced. Both services refuse to boot
# in that configuration for exactly this reason.
