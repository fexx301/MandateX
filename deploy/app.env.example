# Environment contract for the `mandatex-app` service (marketplace-api).
#
# Copy values into Railway's service variables. Do not commit a filled-in copy.
#
# ─────────────────────────────────────────────────────────────────────────────
# THIS SERVICE MUST NOT HOLD A SIGNING KEY.
#
# There is deliberately no variable here for a private key, seed, or mnemonic.
# The process scans its own environment at boot and exits 78 if it finds signing
# material — checked both by variable name and by variable *content*, so a key
# pasted into an innocuously named variable is caught too. If this service could
# sign, every signature it verified would be one it could have produced itself,
# and the two-service trust boundary collapses.
# ─────────────────────────────────────────────────────────────────────────────

# ── Trust: the PUBLIC half of the verifier's key, plus its policy hash ────────
# Read these from the verifier service's GET /v1/trust after it deploys.
# Every value is hex, lowercase.
MANDATEX_TRUST_KEY_ID=mandatex-verifier-1
MANDATEX_TRUST_SPKI_DER_HEX=302a300506032b6570032100<32-byte-key-in-hex>
MANDATEX_TRUST_KEY_FINGERPRINT_SHA256=<sha256 of the SPKI DER above>
MANDATEX_TRUST_POLICY_SHA256=<verifier policy hash>

# A key id containing fixture / insecure / do-not-deploy / test / dev- is
# refused when NODE_ENV=production. The fixture key is forgeable by anyone who
# can read this repository.

# ── The verifier, over Railway's private network ──────────────────────────────
# Plaintext http is correct here and only here: *.railway.internal is not
# reachable from outside the project, and Railway's private network does not
# terminate TLS. The production https requirement is waived for .internal hosts
# for exactly this reason.
MANDATEX_VERIFIER_URL=http://mandatex-verifier.railway.internal:8080

# Leaving this unset is allowed. The API still evaluates attestations posted to
# it, but GET /readyz can no longer check lockstep key agreement, which is the
# mechanism that catches a verifier key rotation before it silently invalidates
# every quote.

# ── Runtime ───────────────────────────────────────────────────────────────────
NODE_ENV=production
# PORT is injected by Railway; the app falls back to 8080.
# HOST defaults to 0.0.0.0 and is already set in the image.

# Clock skew tolerated when checking attestation freshness, in seconds.
MANDATEX_MAX_CLOCK_SKEW_SECONDS=30

# Hard cap on request bodies, in bytes. Enforced on accumulated bytes rather
# than content-length, because a chunked request can lie about its length.
MANDATEX_MAX_REQUEST_BYTES=1048576

# GET /v1/fixtures is unconditionally disabled when NODE_ENV=production, and the
# vectors are not copied into the production image at all. This variable only
# matters outside production, where it can be set to "false" to disable the route.
# MANDATEX_EXPOSE_FIXTURES=false
